---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
---

<section class="work section on-ink" id="work" aria-labelledby="work-title">
  <div class="shell">
    <header class="work__head">
      <div data-reveal>
        <p class="eyebrow">Our work</p>
        <h2 id="work-title">Concrete that still looks right years on.</h2>
      </div>
      <p class="work__note" data-reveal style="--reveal-delay:100ms">
        A look at the kind of work we take on — driveways, slabs, paths and
        finished outdoor areas.
      </p>
    </header>

    <ul class="work__grid">
      {
        projects.map((project, i) => (
          <li class="work__item" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <figure class="work__figure">
              <div class="work__frame">
                <Image
                  src={project.image}
                  alt={project.alt}
                  widths={[480, 800, 1200, 1600]}
                  sizes={
                    i === 0
                      ? '(min-width: 62rem) 62vw, 92vw'
                      : '(min-width: 62rem) 38vw, 92vw'
                  }
                  quality={76}
                  loading="lazy"
                  class="work__image"
                />
              </div>
              <figcaption class="work__caption">
                <span class="work__index">{String(i + 1).padStart(2, '0')}</span>
                <span class="work__title">{project.title}</span>
                <span class="work__category">{project.category}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work {
    overflow: clip;
  }

  /* ---- Head ---------------------------------------------------------- */

  .work__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(3rem, 1.5rem + 5vw, 6rem);
  }

  .work__head h2 {
    max-width: 15ch;
  }

  .work__note {
    max-width: 38ch;
    color: var(--text-muted);
    font-size: var(--step-lead);
    line-height: 1.55;
  }

  @media (min-width: 62rem) {
    .work__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30ch);
      align-items: end;
      gap: 3rem;
    }
  }

  /* ---- Grid ---------------------------------------------------------- */

  .work__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.2vw, 2.5rem);
    row-gap: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work__item {
    grid-column: 1 / -1;
  }

  .work__figure {
    margin: 0;
  }

  .work__frame {
    position: relative;
    overflow: hidden;
    background: var(--ink-800);
  }

  .work__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 1200ms var(--ease-out),
      filter 800ms var(--ease-out);
  }

  /* A scrim that lifts on hover — keeps the grid calm at rest */
  .work__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(10 9 8 / 22%);
    opacity: 1;
    transition: opacity 800ms var(--ease-out);
    pointer-events: none;
  }

  .work__item:hover .work__image {
    transform: scale(1.045);
  }

  .work__item:hover .work__frame::after {
    opacity: 0;
  }

  /* ---- Caption -------------------------------------------------------- */

  .work__caption {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-top: 1.15rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
    transition: border-color var(--dur) var(--ease-out);
  }

  .work__item:hover .work__caption {
    border-color: var(--accent);
  }

  .work__index {
    font-family: var(--font-display);
    font-size: var(--step-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
    flex: none;
  }

  .work__title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-right: auto;
  }

  .work__category {
    font-size: var(--step-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    flex: none;
  }

  /* ---- Mobile aspect ratios -------------------------------------------- */

  .work__frame {
    aspect-ratio: 4 / 3;
  }

  .work__item:nth-child(1) .work__frame {
    aspect-ratio: 4 / 5;
  }

  @media (min-width: 34rem) and (max-width: 61.9375rem) {
    .work__item:nth-child(1) .work__frame {
      aspect-ratio: 3 / 2;
    }
  }

  /* ---- Editorial desktop composition ----------------------------------- */

  @media (min-width: 62rem) {
    .work__item:nth-child(1) {
      grid-column: 1 / 9;
    }

    .work__item:nth-child(1) .work__frame {
      aspect-ratio: 3 / 2;
    }

    .work__item:nth-child(2) {
      grid-column: 9 / 13;
      align-self: end;
    }

    .work__item:nth-child(2) .work__frame {
      aspect-ratio: 3 / 4;
    }

    .work__item:nth-child(3) {
      grid-column: 1 / 6;
      margin-top: clamp(0rem, 4vw, 5rem);
    }

    .work__item:nth-child(3) .work__frame {
      aspect-ratio: 4 / 5;
    }

    .work__item:nth-child(4) {
      grid-column: 6 / 13;
    }

    .work__item:nth-child(4) .work__frame {
      aspect-ratio: 16 / 10;
    }

    .work__item:nth-child(5) {
      grid-column: 5 / 13;
    }

    .work__item:nth-child(5) .work__frame {
      aspect-ratio: 2 / 1;
    }

    /* Anything beyond the composed five falls back to a tidy half-width */
    .work__item:nth-child(n + 6) {
      grid-column: span 6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work__item:hover .work__image {
      transform: none;
    }
  }
</style>
