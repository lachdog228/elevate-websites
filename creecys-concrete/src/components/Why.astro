---
const reasons = [
  {
    title: 'Quality First',
    body: 'Careful preparation and quality workmanship on every project, whether it is a footpath or a full house slab.',
  },
  {
    title: 'Reliable Service',
    body: 'Clear communication and dependable service from the first quote through to the final clean-up.',
  },
  {
    title: 'Attention to Detail',
    body: 'Straight edges, even falls and a consistent finish — the details that separate good concrete from ordinary concrete.',
  },
  {
    title: 'Built to Last',
    body: 'Correctly prepared and reinforced so the work holds up to weather, traffic and time.',
  },
];
---

<section class="why section" aria-labelledby="why-title">
  <div class="shell why__grid">
    <header class="why__head" data-reveal>
      <p class="eyebrow">Why Creecy&rsquo;s</p>
      <h2 id="why-title">Four reasons the work holds up.</h2>
      <p class="lead why__lead">
        Same preparation, same finish — whether it&rsquo;s a single path or a
        full house slab.
      </p>
      <a class="why__link" href="#contact">
        Request a quote
        <span class="btn__arrow" aria-hidden="true">&rarr;</span>
      </a>
    </header>

    <ol class="why__list">
      {
        reasons.map((reason, i) => (
          <li class="why__item" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <span class="why__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="why__title">{reason.title}</h3>
            <p class="why__body">{reason.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .why {
    background: var(--paper);
  }

  .why__grid {
    display: grid;
    gap: clamp(2.5rem, 1rem + 5vw, 5rem);
  }

  .why__head h2 {
    max-width: 13ch;
  }

  .why__lead {
    margin-top: 1.5rem;
    max-width: 34ch;
  }

  .why__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    padding-bottom: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    transition:
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .why__link .btn__arrow {
    transition: transform var(--dur) var(--ease-out);
  }

  .why__link:hover,
  .why__link:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  .why__link:hover .btn__arrow,
  .why__link:focus-visible .btn__arrow {
    transform: translateX(0.3rem);
  }

  .why__list {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: why;
  }

  .why__item {
    position: relative;
    padding-block: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    border-top: 1px solid var(--line);
  }

  .why__num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-label);
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .why__title {
    margin-bottom: 0.7rem;
  }

  .why__body {
    max-width: 40ch;
    color: var(--text-muted);
    font-size: clamp(0.94rem, 0.9rem + 0.2vw, 1.0625rem);
    line-height: 1.6;
  }

  @media (min-width: 48rem) {
    .why__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 5vw, 5rem);
    }

    /* Give the second column a small lift so the pairs don't read as boxes */
    .why__item:nth-child(even) {
      transform: translateY(clamp(0rem, 2.5vw, 3rem));
    }

    .why__item:nth-child(even) {
      border-top-color: var(--line);
    }
  }

  @media (min-width: 62rem) {
    .why__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      align-items: start;
    }

    .why__head {
      position: sticky;
      top: clamp(7rem, 12vh, 9rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .why__item:nth-child(even) {
      transform: none;
    }
  }
</style>
