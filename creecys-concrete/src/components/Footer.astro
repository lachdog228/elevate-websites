---
import Logo from './Logo.astro';
import { nav, site, telHref, mailHref } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer on-ink">
  <div class="shell footer__inner">
    <div class="footer__brand">
      <a href="#top" aria-label={`${site.name} — back to top`}>
        <Logo />
      </a>
      <p class="footer__tagline">
        Concreting done properly — driveways, slabs, paths and finished outdoor
        areas.
      </p>
    </div>

    <nav class="footer__col" aria-label="Footer">
      <h2 class="footer__heading">Site</h2>
      <ul class="footer__links">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__heading">Contact</h2>
      <ul class="footer__links">
        <li><a href={telHref}>{site.phone}</a></li>
        <li><a href={mailHref}>{site.email}</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">Service area</h2>
      <p class="footer__text">{site.serviceArea}</p>
      <a class="btn btn--light footer__cta" href="#contact">
        Get a Quote
        <span class="btn__arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <div class="shell footer__base">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <p class="footer__abn">{site.tagline}</p>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(3.5rem, 2rem + 5vw, 6rem);
    padding-bottom: 2rem;
  }

  .footer__inner {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    padding-bottom: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .footer__brand {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .footer__brand a {
    text-decoration: none;
    justify-self: start;
  }

  .footer__tagline {
    max-width: 32ch;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .footer__heading {
    font-family: var(--font-display);
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .footer__links {
    display: grid;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__links a {
    display: inline-block;
    padding-block: 0.3rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer__links a:hover,
  .footer__links a:focus-visible {
    color: var(--accent-on-ink);
  }

  .footer__text {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    max-width: 26ch;
  }

  .footer__cta {
    margin-top: 1.75rem;
    padding: 0.85rem 1.5rem;
    min-height: 3rem;
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-on-ink);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .footer__abn {
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: var(--step-label);
  }

  @media (min-width: 48rem) {
    .footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .footer__inner {
      grid-template-columns: minmax(0, 4fr) repeat(3, minmax(0, 2.4fr));
      gap: clamp(2rem, 4vw, 5rem);
    }
  }
</style>
