---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
    <path
      d="M22.19 8.26 A10 10 0 1 0 22.19 19.74"
      fill="none"
      stroke="currentColor"
      stroke-width="5"
    ></path>
  </svg>
  <span class="logo__word">
    <span class="logo__word-a">Creecy&rsquo;s</span>
    <span class="logo__word-b">Concrete</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }

  .logo__mark {
    width: 1.55rem;
    height: 1.55rem;
    flex: none;
    color: var(--accent);
  }

  .logo__word {
    display: flex;
    gap: 0.4em;
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .logo__word-a {
    font-weight: 700;
  }

  .logo__word-b {
    font-weight: 400;
    opacity: 0.75;
  }

  @media (max-width: 26rem) {
    .logo__mark {
      width: 1.35rem;
      height: 1.35rem;
    }

    .logo__word {
      font-size: 0.88rem;
    }
  }
</style>
